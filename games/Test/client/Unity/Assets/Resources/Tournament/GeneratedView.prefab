  source: "{\"schemaVersion\":1,\"title\":\"Dual-Mode Tournament\",\"width\":720,\"height\":550,\"background\":\"#10232F\",\"nodes\":[{\"id\":\"title\",\"kind\":\"text\",\"parent\":\"\",\"pages\":[],\"binding\":\"\",\"text\":\"Dual-Mode
    Tournament\",\"color\":\"\",\"asset\":\"\",\"x\":32,\"y\":23,\"width\":600,\"height\":50,\"fontSize\":34,\"padding\":0,\"spacing\":0},{\"id\":\"accent\",\"kind\":\"image\",\"parent\":\"\",\"pages\":[],\"binding\":\"\",\"text\":\"\",\"color\":\"#52999A\",\"asset\":\"\",\"x\":32,\"y\":82,\"width\":656,\"height\":2,\"fontSize\":0,\"padding\":0,\"spacing\":0},{\"id\":\"status\",\"kind\":\"text\",\"parent\":\"\",\"pages\":[],\"binding\":\"status\",\"text\":\"Join
    a tournament\",\"color\":\"#BCE1DE\",\"asset\":\"\",\"x\":32,\"y\":94,\"width\":656,\"height\":42,\"fontSize\":21,\"padding\":0,\"spacing\":0},{\"id\":\"entry\",\"kind\":\"panel\",\"parent\":\"\",\"pages\":[\"join\"],\"binding\":\"\",\"text\":\"\",\"color\":\"\",\"asset\":\"\",\"x\":32,\"y\":153,\"width\":656,\"height\":231,\"fontSize\":0,\"padding\":0,\"spacing\":0},{\"id\":\"server-label\",\"kind\":\"text\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"\",\"text\":\"Server\",\"color\":\"#BCD0D7\",\"asset\":\"\",\"x\":0,\"y\":0,\"width\":153,\"height\":48,\"fontSize\":19,\"padding\":0,\"spacing\":0},{\"id\":\"server\",\"kind\":\"input\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"server\",\"text\":\"Server\",\"color\":\"#263B48\",\"asset\":\"\",\"x\":170,\"y\":0,\"width\":486,\"height\":48,\"fontSize\":20,\"padding\":12,\"spacing\":0},{\"id\":\"room-label\",\"kind\":\"text\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"\",\"text\":\"Room
    code\",\"color\":\"#BCD0D7\",\"asset\":\"\",\"x\":0,\"y\":74,\"width\":153,\"height\":48,\"fontSize\":19,\"padding\":0,\"spacing\":0},{\"id\":\"room\",\"kind\":\"input\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"room\",\"text\":\"Room
    code\",\"color\":\"#263B48\",\"asset\":\"\",\"x\":170,\"y\":74,\"width\":486,\"height\":48,\"fontSize\":20,\"padding\":12,\"spacing\":0},{\"id\":\"player-label\",\"kind\":\"text\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"\",\"text\":\"Player
    name\",\"color\":\"#BCD0D7\",\"asset\":\"\",\"x\":0,\"y\":148,\"width\":153,\"height\":48,\"fontSize\":19,\"padding\":0,\"spacing\":0},{\"id\":\"player\",\"kind\":\"input\",\"parent\":\"entry\",\"pages\":[],\"binding\":\"player\",\"text\":\"Player
    name\",\"color\":\"#263B48\",\"asset\":\"\",\"x\":170,\"y\":148,\"width\":486,\"height\":48,\"fontSize\":20,\"padding\":12,\"spacing\":0},{\"id\":\"join\",\"kind\":\"button\",\"parent\":\"\",\"pages\":[\"join\"],\"binding\":\"join\",\"text\":\"Join
    room\",\"color\":\"#275966\",\"asset\":\"\",\"x\":440,\"y\":463,\"width\":248,\"height\":51,\"fontSize\":18,\"padding\":8,\"spacing\":0},{\"id\":\"score\",\"kind\":\"text\",\"parent\":\"\",\"pages\":[\"lobby\",\"reconnect\",\"results\"],\"binding\":\"score\",\"text\":\"Score  
    1 \u2013 0\",\"color\":\"\",\"asset\":\"\",\"x\":32,\"y\":147,\"width\":620,\"height\":57,\"fontSize\":39,\"padding\":0,\"spacing\":0},{\"id\":\"next\",\"kind\":\"text\",\"parent\":\"\",\"pages\":[\"lobby\",\"reconnect\"],\"binding\":\"next\",\"text\":\"Round
