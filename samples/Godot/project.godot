; Open with Godot .NET 4.5.2 or a compatible version.
config_version=5

[application]
config/name="AwithGameFrame Shared Demo"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")

[display]
window/size/viewport_width=800
window/size/viewport_height=450

[dotnet]
project/assembly_name="AwithGameFrame.Godot.Sample"

[rendering]
renderer/rendering_method="gl_compatibility"
