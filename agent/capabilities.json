{
  "schemaVersion": 1,
  "capabilities": [
    {
      "id": "workflow.design-clarification",
      "kind": "workflow",
      "description": "Clarify player experience, content scope, presentation direction and acceptance before implementing unresolved game content.",
      "owner": ".agents/skills/awith-content-design/SKILL.md",
      "entryPoint": ".agents/skills/awith-content-design/SKILL.md",
      "modes": ["conversation", "manual"],
      "parameters": ["requestType", "designSource", "experienceScope", "openDesignDecisions"],
      "checks": ["agent-contracts"]
    },
    {
      "id": "workflow.specification",
      "kind": "workflow",
      "description": "Turn an agreed behavior into a bounded task with ownership, acceptance, scope and required checks.",
      "owner": "agent/templates/task-brief.md",
      "entryPoint": "tools/agent.ps1 new",
      "modes": ["conversation", "manual"],
      "parameters": ["taskTemplate", "taskId"],
      "checks": ["agent-contracts"]
    },
    {
      "id": "workflow.ticket-slicing",
      "kind": "workflow",
      "description": "Split an agreed specification into dependency-aware slices that can be handed to another session.",
      "owner": "agent/templates/ticket-board.json",
      "entryPoint": "tools/agent.ps1 board-import",
      "modes": ["conversation", "manual"],
      "parameters": ["boardSpec", "ticketId", "priority"],
      "checks": ["agent-contracts"]
    },
    {
      "id": "workflow.diagnosis",
      "kind": "workflow",
      "description": "Reproduce a failure at a public boundary, collect distinguishing evidence and rerun the same check after the fix.",
      "owner": ".agents/skills/awith-framework-development/references/workflows.md",
      "entryPoint": "docs/guides/ai-collaboration.md#先诊断再修改",
      "modes": ["conversation", "manual"],
      "parameters": ["reproduction", "expected", "actual", "verification"],
      "checks": ["portable-verify"]
    },
    {
      "id": "workflow.delivery-review",
      "kind": "workflow",
      "description": "Review implementation against the agreed behavior, ownership, compatibility, failure paths and evidence before delivery.",
      "owner": "agent/templates/review.md",
      "entryPoint": "tools/agent.ps1 review",
      "modes": ["manual"],
      "parameters": ["reviewer", "decision", "reason"],
      "checks": ["agent-contracts"]
    },
    {
      "id": "workspace.game-build-sync",
      "kind": "build",
      "description": "Build external game Domain/Application and server code, then synchronize the current DLL/PDB identity into the Unity workspace.",
      "owner": "tools/game.ps1",
      "entryPoint": "tools/game.ps1 build|sync -Name <game>",
      "modes": ["background", "manual"],
      "parameters": ["gameName"],
      "checks": ["game-build"],
      "mutatesProject": true
    },
    {
      "id": "unity.editor.actions",
      "kind": "editor",
      "description": "List supported Unity editor actions and their argument syntax.",
      "owner": "tools/unity-editor.ps1",
      "entryPoint": "tools/unity-editor.ps1 -Action actions",
      "modes": ["background"],
      "checks": ["unity-editor-verify"]
    },
    {
      "id": "unity.prefab.inspect",
      "kind": "editor",
      "description": "Read a Prefab's hierarchy, components, GUID, asset type and dependencies.",
      "owner": "tools/unity-editor.ps1",
      "entryPoint": "tools/unity-editor.ps1 -Action prefab.inspect",
      "modes": ["background", "live-editor"],
      "parameters": ["asset", "limit"],
      "checks": ["unity-editor-verify"]
    },
    {
      "id": "unity.editor.transaction",
      "kind": "editor",
      "description": "Preview or apply dependent Unity scene edits as one bounded transaction with persisted result evidence.",
      "owner": "tools/unity-editor.ps1",
      "entryPoint": "tools/unity-editor.ps1 -Action scene.transaction",
      "modes": ["background", "live-editor"],
      "parameters": ["projectPath", "scene", "stepsFile", "preview", "save"],
      "checks": ["unity-editor-verify"],
      "mutatesProject": true
    },
    {
      "id": "unity.editor.diagnostics",
      "kind": "verification",
      "description": "Collect Unity compiler messages and editor diagnostics without opening a visible game window.",
      "owner": "tools/unity-editor.ps1",
      "entryPoint": "tools/unity-editor.ps1 -Action editor.diagnostics",
      "modes": ["background", "live-editor"],
      "parameters": ["projectPath", "editorPath", "limit"],
      "checks": ["unity-editor-verify"]
    },
    {
      "id": "unity.game-tests",
      "kind": "verification",
      "description": "Compile a named Unity game in a hidden disposable project, run its tests, and report the failed step with its logs.",
      "owner": "tools/verify-game-unity.ps1",
      "entryPoint": "tools/verify-game-unity.ps1 -RunTests",
      "modes": ["background"],
      "parameters": ["gameName", "editorPath"],
      "checks": ["game-unity-tests"]
    },
    {
      "id": "unity.visual-verification",
      "kind": "verification",
      "description": "Run hidden Unity rendering checks and produce screenshots, difference images and machine-readable visual reports.",
      "owner": "tools/verify-game-unity.ps1",
      "entryPoint": "tools/verify-game-unity.ps1 -VisualSpec",
      "modes": ["background", "manual"],
      "parameters": ["gameName", "editorPath", "visualSpec"],
      "checks": ["unity-verify"]
    },
    {
      "id": "unity.resource-audit",
      "kind": "verification",
      "description": "Verify declared Resources keys, Unity types, fallback resolution and Sprite Atlas membership in an isolated game workspace.",
      "owner": "docs/reference/unity-resource-audit.md",
      "entryPoint": "tools/verify-game-unity.ps1 -ResourceSpec | -AtlasSpec",
      "modes": ["background"],
      "parameters": ["gameName", "editorPath", "resourceSpec", "atlasSpec"]
    },
    {
      "id": "unity.migration-preflight",
      "kind": "verification",
      "description": "Import disposable copies of Unity projects and locate broken scripts, GUIDs and object references.",
      "owner": "tools/verify-unity-migration.ps1",
      "entryPoint": "tools/verify-unity-migration.ps1",
      "modes": ["background"],
      "parameters": ["editorPath", "projectPath", "sourceProjectPath", "sourceEditorPath", "targetProjectPath"]
    },
    {
      "id": "unity.art-import-profile",
      "kind": "content",
      "description": "Preview and apply project texture import settings with Sprite geometry and identity checks.",
      "owner": "docs/reference/unity-art-import-profiles.md",
      "entryPoint": "AwithGameFrame.Unity.Editor.Content.UnityArtImportProfileMenu.RunBatch",
      "modes": ["background", "manual"],
      "parameters": ["profilePath", "mode", "reportPath"],
      "mutatesProject": true
    },
    {
      "id": "unity.player-smoke",
      "kind": "verification",
      "description": "Run an existing Windows Player in batch mode and record game smoke results and offscreen screenshots.",
      "owner": "tools/run-unity-player-smoke.ps1",
      "entryPoint": "tools/run-unity-player-smoke.ps1",
      "modes": ["background"],
      "parameters": ["playerPath", "flag", "successMarker", "captureFlag", "evidenceDirectory"]
    },
    {
      "id": "content.generated-asset-manifest",
      "kind": "content",
      "description": "Record generator identity, input hash, seed, output hashes and stale status for runtime-generated or baked assets.",
      "owner": "src/AwithGameFrame.Data/Runtime/Generation/GeneratedAssetManifest.cs",
      "entryPoint": "AwithGameFrame.Data.Generation.GeneratedAssetManifest",
      "modes": ["background", "manual"],
      "parameters": ["generatorId", "generatorVersion", "inputHash", "outputs"],
      "checks": ["portable-verify"]
    },
    {
      "id": "content.asset-bundle-pipeline",
      "kind": "content",
      "description": "Build Unity AssetBundles or Godot PCK content, publish a catalog, install it through the content snapshot and verify rollback behavior.",
      "owner": "docs/guides/content-pipeline.md",
      "entryPoint": "tools/build-unity-content.ps1|tools/build-godot-content.ps1",
      "modes": ["background", "manual"],
      "parameters": ["projectPath", "specificationPath", "outputDirectory", "buildTarget"],
      "checks": ["portable-verify", "unity-verify"]
    },
    {
      "id": "content.addressables-loader",
      "kind": "content",
      "description": "Load Unity Addressables assets and additive scenes through ResourceStore and SceneService.",
      "owner": "adapters/unity-addressables/README.md",
      "entryPoint": "AwithGameFrame.Unity.Addressables.AddressablesResourceLoader",
      "modes": ["background", "live-editor", "manual"],
      "parameters": ["key", "resourceType", "cancellationToken"],
      "checks": ["unity-addressables-verify"]
    }
  ]
}
